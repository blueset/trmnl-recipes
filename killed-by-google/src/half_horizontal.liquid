{% if error %}
  {% render "kbg_error", error: error, mode_label: mode_label %}
{% else %}
  <div class="layout relative kbg-layout kbg-layout--compact">
    <div class="relative w--full h--full kbg-scene">
      <article class="relative portrait:flex--col w--full h--full bg--gray-75 1bit:text-stroke 2bit:text-stroke kbg-compact-stone">
        <div class="kbg-seal">RIP</div>
        <div class="relative flex--col text--center kbg-compact-content">
          <span class="kbg-kicker">{{ product.type }}</span>
          <h1 class="kbg-compact-name">{{ product.name }}</h1>
          <span class="kbg-compact-years">
            {{ product.year_open }} &mdash; {{ product.year_close }}
          </span>
          <p class="hidden portrait:hidden lg:block lg:portrait:block kbg-compact-description" data-clamp="3">
            {{ product.description_line }}
          </p>
        </div>
      </article>
    </div>
  </div>
  {% render "kbg_title_bar", mode_label: mode_label %}
{% endif %}
