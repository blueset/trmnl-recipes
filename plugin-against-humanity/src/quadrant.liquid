<div class="gap--small h--full layout layout--stretch layout--col typography--ss p--0">
  {% assign black_count = black | size %}
  {% assign white_count = white | size %}
  {% if black_count > 0 %}
    {% for card in black %}
      <div class="flex flex--col flex--left gap--none bg--black p--4 border border--1 outline">
        <div class="text--base text--bold text--white lg:text--large grow">{{ card.text | replace: "_", '<span class="blank">____________</span>' }}</div>
        <div class="hidden lg:block text--bold text--small text--white lg:text--base flex flex--center gap--small">{% render "pack_icon" %} {{ card.pack }}</div>
      </div>
    {% endfor %}
  {% endif %}
  {% if white_count > 0 %}
    {% for card in white %}
      <div class="flex flex--col flex--left gap--none p--4 border border--1 outline w--full">
        <div class="text--base text--bold lg:text--large grow">{{ card.text }}</div>
        <div class="hidden lg:block text--bold text--small lg:text--base flex flex--center gap--small">{% render "pack_icon" %} {{ card.pack }}</div>
      </div>
    {% endfor %}
  {% endif %}
</div>
{% render "smartquote" %}
<!-- Title bar omitted intentionally. -->