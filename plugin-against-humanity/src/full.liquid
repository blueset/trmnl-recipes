<div class="gap--small h--full layout layout--row layout--stretch portrait:layout--col typography--ss">
  {% assign black_count = black | size %}
  {% assign white_count = white | size %}
  {% if black_count > 0 %}
    <div class="portrait:contents flex flex--col flex--stretch w--0 grow">
      {% for card in black %}
        <div class="flex flex--col flex--left gap--none bg--black p--4 lg:p--8 border border--1 outline grow">
          <div class="text--bold text--white text--xxlarge lg:text--xxxlarge grow">{{ card.text | replace: "_", '<span class="blank">______________</span>' }}</div>
          <div class="text--base text--bold text--white lg:text--xlarge flex flex--center gap--small">{% render "pack_icon" %} {{ card.pack }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
  {% if white_count > 0 %}
    <div class="portrait:contents flex flex--col flex--stretch w--0 grow">
      {% for card in white %}
        <div class="flex flex--col flex--left gap--none p--4 lg:p--8 border border--1 outline w--full grow">
          <div class="text--bold text--xxlarge lg:text--xxxlarge grow">{{ card.text }}</div>
          <div class="text--base text--bold lg:text--xlarge flex flex--center gap--small">{% render "pack_icon" %} {{ card.pack }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% render "smartquote" %}
<!-- Title bar omitted intentionally. -->