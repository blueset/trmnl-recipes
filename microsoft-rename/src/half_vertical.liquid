{% if error %}
  {% render "rename_error", error: error, mode: mode %}
{% else %}
  {% assign vertical_name_class = "title title--small md:title--base lg:title--xlarge" %}
  {% assign vertical_detail_class = "text text--xsmall md:text--small lg:text--large" %}
  {% assign vertical_family_class = "label label--small md:label--base lg:label--xlarge 2bit:label--gray 4bit:label--gray font--regular" %}
  {% assign vertical_minor_name_class = "label label--small md:label--base lg:label--xlarge" %}

  {% if mode == "recent" %}
    <div class="layout">
      <div class="gap--large grid grid--cols-1 stretch-x">
        <div class="flex flex--center flex--col gap--none">
          <span class="value value--xxlarge md:value--xxxlarge lg:value--giga portrait:value--xlarge md:portrait:value--xxlarge lg:portrait:value--mega" data-fit-value="true">
            {{ product.days_since_rename }}
          </span>
          <span class="text--center label label--small md:label--base lg:label--xlarge">
            days since the latest rename
          </span>
        </div>
        <div class="flex flex--center-y flex--col gap--medium">
          {% render "rename_full_identity",
            product: product,
            hide_note: true,
            identity_layout_class: "flex flex--center-y flex--row portrait:flex--col gap--medium",
            family_class: vertical_family_class,
            logo_class: "image image--contain image-dither w--[20cqw] h--[14cqh] md:w--[22cqw] md:h--[16cqh] lg:w--[24cqw] lg:h--[18cqh] portrait:w--[40cqw] portrait:h--[25cqw]",
            name_class: vertical_name_class,
            detail_class: vertical_detail_class
          %}
          {% render "rename_full_history",
            product: product,
            history_limit: 2,
            heading_class: vertical_family_class,
            name_class: vertical_minor_name_class,
            duration_class: vertical_detail_class
          %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="layout">
      <div class="gap--large grid grid--cols-1 stretch-x">
        <div class="flex flex--center-y flex--col">
          {% render "rename_full_identity",
            product: product,
            hide_note: true,
            show_current_duration: true,
            identity_layout_class: "flex flex--center-y flex--row portrait:flex--col gap--medium",
            family_class: vertical_family_class,
            logo_class: "image image--contain w--[20cqw] h--[14cqh] md:w--[22cqw] md:h--[16cqh] lg:w--[24cqw] lg:h--[18cqh] portrait:w--[40cqw] portrait:h--[25cqw]",
            name_class: vertical_name_class,
            detail_class: vertical_detail_class
          %}
        </div>
        <div class="flex flex--center-y flex--col">
          {% render "rename_full_history",
            product: product,
            history_limit: 2,
            heading_class: vertical_family_class,
            name_class: vertical_minor_name_class,
            duration_class: vertical_detail_class
          %}
        </div>
      </div>
    </div>
  {% endif %}
  {% render "rename_title_bar", mode: mode %}
{% endif %}
