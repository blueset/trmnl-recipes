<div style="display: contents;" lang="{{ trmnl.user.locale | escape }}" data-t-data="{{ custom_next_holiday_strings | json | escape }}" data-holidays="{{ trmnl.plugin_settings.custom_fields_values.holidays | escape }}">
  <div class="layout layout--row" data-tz="{{ trmnl.user.time_zone_iana }}">
    <div class="flex flex-row port:flex-col justify-center w-full h-full grow">
      <div class="place-content-center w-0 port:w-full port:h-[30cqh] text-center port:text-start grow-1 port:grow-0" style="container-type: size;">
        <iconify-icon icon="mdi:home" class="text-[75cqmin] port:text-[100cqmin] image-dither"></iconify-icon>
      </div>
      <div class="place-content-center w-0 port:w-full grow-2 port:grow-0" data-text-container>
      </div>
    </div>
  </div>

  <div class="title_bar">
    <svg xmlns="http://www.w3.org/2000/svg" class="image image-stroke image-dither" viewBox="0 0 24 24"><path fill="currentColor" d="M17.5 12a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11m.25-9A3.25 3.25 0 0 1 21 6.25l.001 5.773a6.5 6.5 0 0 0-1.5-.71L19.5 8.5h-15v9.25c0 .966.784 1.75 1.75 1.75h5.064c.172.534.412 1.038.709 1.501L6.25 21A3.25 3.25 0 0 1 3 17.75V6.25A3.25 3.25 0 0 1 6.25 3zm-.766 11.046l-.04.098l-.556 1.787h-1.803c-.532 0-.772.668-.417 1.036l.074.065l1.458 1.105l-.557 1.787c-.165.53.375.975.821.73l.078-.05L17.5 19.5l1.458 1.104c.433.328 1.006-.07.92-.588l-.021-.092l-.557-1.787l1.458-1.105c.43-.326.248-1.014-.247-1.093l-.096-.008h-1.803l-.557-1.787a.576.576 0 0 0-1.071-.098M17.75 4.5H6.25A1.75 1.75 0 0 0 4.5 6.25V7h15v-.75a1.75 1.75 0 0 0-1.75-1.75"></path></svg>
    <span class="title" data-t="next_holiday">Next holiday</span>
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
  </div>
</div>
{% render "common", trmnl: trmnl, 
  mainValueClass: "value--large lg:value--xlarge",
  mainLabelClass: "value--small lg:value--base",
  subLabelClass: "value--xsmall lg:value--base",
%}

