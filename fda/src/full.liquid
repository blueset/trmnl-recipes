<div class="layout">
  {% if data.size > 0 %}
  <div class="columns" data-overflow-cols="3" data-overflow-cols-portrait="1" data-overflow-cols-lg-portrait="2">
    <div class="column">
      {% for item in data %}
      <div class="item">
        <div class="meta">
          {% if item[6] != "" %}<span class="index">T</span>{% endif %}
        </div>
        <div class="content">
          <span class="description">{{ item[1] | replace: "<a", "<span" | replace: "</a", "</span" }}</span>
          <span class="title title--small">{% render "icon", type: item[3] %} {{ item[2] }}</span>
          <span class="description">{{ item[4] }} ({{ item[0] | strip }})</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="richtext"><span class="description">No recalls found for your criteria.</span></div>
  {% endif %}
</div>

<div class="title_bar">
  {% render "fda" %}
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
</div>